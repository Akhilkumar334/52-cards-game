{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@cards/engine": ["../engine/src/index.ts"],
      "@cards/engine/*": ["../engine/src/*"],
      "@cards/bots": ["../bots/src/index.ts"],
      "@cards/bots/*": ["../bots/src/*"]
    }
  },
  "include": ["src/**/*"]
}
