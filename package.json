{
  "name": "cards-game-platform",
  "private": true,
  "type": "module",
  "workspaces": ["engine", "bots", "ui"],
  "scripts": {
    "dev": "npm run dev --workspace=ui",
    "build": "npm run build --workspace=ui",
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p engine/tsconfig.json --noEmit && tsc -p bots/tsconfig.json && tsc -p ui/tsconfig.json"
  },
  "devDependencies": {
    "vitest": "^1.6.0",
    "typescript": "^5.4.0",
    "prettier": "^3.2.0"
  }
}
